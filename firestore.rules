rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function approvedMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/bkop/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/workspaces/bkop/members/$(request.auth.uid)).data.status == 'active';
    }

    match /workspaces/bkop/members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || approvedMember());
      allow write: if false;
    }

    match /workspaces/bkop/data/{document} {
      allow read, write: if approvedMember();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
